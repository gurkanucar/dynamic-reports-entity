<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.2.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.gucardev</groupId>
    <artifactId>dynamic-reports-entity</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>dynamic-reports-entity</name>
    <description>
        entity-reports: a plug-in reporting library (annotate JPA entities, analysts build datasets from them);
        app: the platform that uses it.
    </description>

    <modules>
        <module>entity-reports</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Explicit so IntelliJ never falls back to the ancient default bytecode target (1.5) -->
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <poi.version>5.4.1</poi.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.gucardev</groupId>
                <artifactId>entity-reports</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Excel (.xlsx) exports, written streaming (SXSSF) so large datasets do not fill the heap -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Tests never read the developer's .env (it may select a profile, a database or real keys) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <DOTENV_FILE>target/no-such-dotenv</DOTENV_FILE>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
