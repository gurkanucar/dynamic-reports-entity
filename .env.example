# Settings and secrets, read from a file called .env:
#   - by the app when you run it locally (mvnw spring-boot:run / the IDE, started in this folder),
#   - by docker compose (docker-compose.yml) and Dokploy (paste it into the service's "Environment" tab).
# Copy this file to .env and fill it in. .env is git-ignored: never commit real keys or passwords.
# Real environment variables win over the file.

# ---- everywhere ------------------------------------------------------------------------------------

# Password of the demo users (admin@mail.com, admin, alice, bob, carol). Required for docker compose / Dokploy.
DEMO_PASSWORD=password

# AI assistant (datasets, mail templates, flows, steps, cron): OpenRouter or any OpenAI-compatible API
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=z-ai/glm-5.3-flash
OPENROUTER_API_KEY=
# ASSISTANT_BASE_URL=https://openrouter.ai/api/v1

# Kafka triggers and "Kafka'ya yaz" steps
FLOWS_KAFKA_ENABLED=true
# Topics flows may use
# FLOWS_KAFKA_ALLOWED_TOPICS=flows.*

# Hosts "HTTP isteği" steps may call (comma separated)
FLOWS_WEBHOOK_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- local development (docker-compose.dev.yml for Postgres, S3Mock, Kafka, Mailpit) ---------------

# small = hand-written demo data on disk (./data); postgres = the dev compose's PostgreSQL
SPRING_PROFILES_ACTIVE=small
# DATABASE_URL=jdbc:h2:mem:datasets          (throw-away database instead of ./data)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# MAIL_HOST=localhost
# MAIL_PORT=1025
# STORAGE_TYPE=s3                            (or filesystem)
# S3_ENDPOINT=http://localhost:9090
# S3_BUCKET=flow-files
# S3_ACCESS_KEY=dev
# S3_SECRET_KEY=dev

# ---- docker compose / Dokploy (docker-compose.yml) -------------------------------------------------

# The address people open: links in approval e-mails
PUBLIC_URL=https://veri-akis.example.com
# true behind HTTPS (Dokploy/Traefik); false only for plain http://localhost:8088
SESSION_COOKIE_SECURE=true
# Host port of the web container when there is no proxy in front
WEB_PORT=8088
