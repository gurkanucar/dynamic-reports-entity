### Users (password "password"): alice (HR), carol (Software Development), bob (IT, salary), admin (everything)
### Fields are paths from "root": department.name, manager.fullName, trainingRecords.training.name, ...
### Data: ~100k personnel / ~800k rows by default; only the small set with -Dspring-boot.run.profiles=small

### 1. Catalog: entities, the fields this user may use, relations, operators, aggregates, date groups
GET http://localhost:8080/api/reports/catalog
Authorization: Basic alice password

### 2. Many-to-one + GROUP BY + HAVING: departments with >= 3 active people, by average salary
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "Personnel",
  "columns": [
    {"field": "department.name"},
    {"aggregate": "COUNT", "label": "Headcount"},
    {"field": "salary", "aggregate": "AVG", "label": "Average Salary"},
    {"field": "salary", "aggregate": "MAX", "label": "Top Salary"}
  ],
  "where":  {"field": "active", "operator": "EQ", "value": true},
  "having": {"aggregate": "COUNT", "operator": "GTE", "value": 3},
  "sort":   [{"field": "salary", "aggregate": "AVG", "direction": "DESC"}]
}

### 3. Org chart: hierarchy (self-reference) + department manager (2nd relation to Personnel) + member stats (one-to-many)
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "Department",
  "columns": [
    {"field": "parent.name", "label": "Parent"},
    {"field": "name", "label": "Department"},
    {"field": "manager.fullName", "label": "Manager"},
    {"field": "members.fullName", "aggregate": "COUNT", "label": "Headcount"},
    {"field": "members.hireDate", "aggregate": "MIN", "label": "Earliest Hire"}
  ],
  "sort": [{"field": "parent.name"}, {"field": "name"}]
}

### 4. Span of control: managers with at least 3 direct reports (inverse self-reference)
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "Personnel",
  "columns": [
    {"field": "fullName", "label": "Manager"},
    {"field": "department.name"},
    {"field": "directReports.fullName", "aggregate": "COUNT", "label": "Direct Reports"},
    {"field": "directReports.salary", "aggregate": "SUM", "label": "Team Payroll"}
  ],
  "having": {"field": "directReports.fullName", "aggregate": "COUNT", "operator": "GTE", "value": 3},
  "sort":   [{"field": "directReports.fullName", "aggregate": "COUNT", "direction": "DESC"}]
}

### 5. Two-level self-reference: person, manager, manager's manager
POST http://localhost:8080/api/reports/run?page=0&size=50
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "Personnel",
  "columns": [{"field": "fullName"}, {"field": "manager.fullName"}, {"field": "manager.manager.fullName"}],
  "where": {"field": "department.parent.name", "operator": "EQ", "value": "Information Technology"},
  "sort": [{"field": "fullName"}]
}

### 6. Four relations deep: training records of people whose manager's department belongs to IT
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "TrainingRecord",
  "columns": [
    {"field": "personnel.fullName"},
    {"field": "training.name"},
    {"field": "personnel.manager.fullName"},
    {"field": "personnel.manager.department.parent.name", "label": "Manager's Division"}
  ],
  "where": {"field": "personnel.manager.department.parent.name", "operator": "EQ", "value": "Information Technology"},
  "sort": [{"field": "personnel.fullName"}, {"field": "training.name"}]
}

### 7. Compliance: mandatory trainings overdue (last year) or due within 30 days, per department and category
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "TrainingRecord",
  "columns": [
    {"field": "personnel.department.name"},
    {"field": "training.category"},
    {"aggregate": "COUNT", "label": "Records"},
    {"field": "personnel.fullName", "aggregate": "COUNT_DISTINCT", "label": "People"},
    {"field": "score", "aggregate": "AVG", "label": "Average Score"}
  ],
  "where": {"conditions": [
    {"field": "training.mandatory", "operator": "EQ", "value": true},
    {"field": "status", "operator": "NOT_IN", "value": ["FAILED"]},
    {"logic": "OR", "conditions": [
      {"field": "nextRenewalDate", "operator": "LAST_N_DAYS", "value": 365},
      {"field": "nextRenewalDate", "operator": "NEXT_N_DAYS", "value": 30}
    ]}
  ]},
  "having": {"aggregate": "COUNT", "operator": "GTE", "value": 1},
  "sort": [{"aggregate": "COUNT", "direction": "DESC"}, {"field": "personnel.department.name"}]
}

### 8. Optional one-to-one: people without a profile (LEFT JOIN + IS_NULL)
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "Personnel",
  "columns": [{"field": "fullName"}, {"field": "hireDate"}],
  "where": {"field": "profile.birthDate", "operator": "IS_NULL"},
  "sort": [{"field": "hireDate", "direction": "DESC"}]
}

### 9. Pure many-to-many + nested OR + NOT_IN + STARTS_WITH
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "Personnel",
  "columns": [{"field": "fullName"}, {"field": "department.name"}, {"field": "skills.skill.name"}],
  "where": {"conditions": [
    {"logic": "OR", "conditions": [
      {"field": "skills.skill.name", "operator": "IN", "value": ["Kubernetes", "Java"]},
      {"field": "skills.skill.category", "operator": "STARTS_WITH", "value": "Fin"}
    ]},
    {"field": "department.name", "operator": "NOT_IN", "value": ["Sales"]},
    {"field": "hireDate", "operator": "BETWEEN", "value": ["2015-01-01", "2025-12-31"]}
  ]},
  "sort": [{"field": "fullName"}, {"field": "skills.skill.name"}]
}

### 10. Skill demand from the other side of the junction: active holders per skill
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "Skill",
  "columns": [
    {"field": "category"},
    {"field": "name"},
    {"field": "holders.personnel.fullName", "aggregate": "COUNT", "label": "Holders"}
  ],
  "where":  {"field": "holders.personnel.active", "operator": "EQ", "value": true},
  "having": {"field": "holders.personnel.fullName", "aggregate": "COUNT", "operator": "GTE", "value": 3},
  "sort":   [{"field": "holders.personnel.fullName", "aggregate": "COUNT", "direction": "DESC"}]
}

### 11. Project portfolio per owning department: budget and timeline (no one-to-many join, so SUM is safe)
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "Project",
  "columns": [
    {"field": "department.name", "label": "Owner"},
    {"field": "status"},
    {"aggregate": "COUNT", "label": "Projects"},
    {"field": "budget", "aggregate": "SUM", "label": "Total Budget"},
    {"field": "startDate", "aggregate": "MIN", "label": "First Start"},
    {"field": "endDate", "aggregate": "MAX", "label": "Last End"}
  ],
  "where": {"field": "status", "operator": "IN", "value": ["ACTIVE", "PLANNED", "ON_HOLD"]},
  "sort": [{"field": "budget", "aggregate": "SUM", "direction": "DESC"}]
}

### 12. Staffing (many-to-many with fields across modules): allocation and average salary per project
POST http://localhost:8080/api/reports/run
Authorization: Basic admin password
Content-Type: application/json

{
  "root": "ProjectAssignment",
  "columns": [
    {"field": "project.code"}, {"field": "project.name"}, {"field": "project.department.name", "label": "Owner"},
    {"aggregate": "COUNT", "label": "People"},
    {"field": "allocationPercent", "aggregate": "SUM", "label": "Total Allocation (%)"},
    {"field": "personnel.salary", "aggregate": "AVG", "label": "Average Salary"}
  ],
  "having": {"field": "allocationPercent", "aggregate": "SUM", "operator": "GT", "value": 100},
  "sort": [{"field": "allocationPercent", "aggregate": "SUM", "direction": "DESC"}]
}

